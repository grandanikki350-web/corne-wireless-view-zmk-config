#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&kt CAPS>;
            key-positions = <39 40>;
            layers = <0>;
            slow-release;
        };

        mouup {
            bindings = <&msc MOVE_Y(20)>;
            key-positions = <19 39>;
            layers = <0>;
            slow-release;
        };

        moudn {
            bindings = <&msc (MOVE_Y(-20))>;
            key-positions = <20 21>;
            layers = <0>;
            slow-release;
        };

        mouleft {
            bindings = <&msc (MOVE_X(-20))>;
            key-positions = <21 22>;
            layers = <0>;
            slow-release;
        };

        mouright {
            bindings = <&msc MOVE_X(20)>;
            key-positions = <22 34>;
            layers = <0>;
            slow-release;
        };

        up {
            bindings = <&mmv MOVE_UP>;
            key-positions = <16 38>;
            slow-release;
            layers = <0>;
        };

        down {
            bindings = <&mmv MOVE_DOWN>;
            key-positions = <15 16>;
            layers = <0>;
            slow-release;
        };

        left {
            bindings = <&mmv MOVE_LEFT>;
            key-positions = <14 15>;
            layers = <0>;
            slow-release;
        };

        right {
            bindings = <&mmv MOVE_RIGHT>;
            key-positions = <13 14>;
            slow-release;
            layers = <0>;
        };

        leftclick {
            bindings = <&mkp LCLK>;
            key-positions = <38 37>;
            layers = <0>;
            slow-release;
        };

        rightclick {
            bindings = <&mkp RCLK>;
            key-positions = <16 15>;
            layers = <0>;
            slow-release;
        };

        mclk {
            bindings = <&mkp MCLK>;
            key-positions = <16 13>;
            layers = <0>;
            slow-release;
        };

        leftcontrol {
            bindings = <&kp RC(LEFT_ARROW)>;
            key-positions = <22 10>;
            layers = <0>;
            slow-release;
        };

        controlright {
            bindings = <&kp RC(RIGHT)>;
            key-positions = <35 23>;
        };
    };

    macros {
        new_macro2: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NEW_MACRO";
        };

        emojis: new_macro5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NEW_MACRO5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&to 3    &kp Q  &kp W  &kp E              &kp R  &kp T         &kp Y            &kp U          &kp I      &kp O    &kp P         &to 4
&to 4    &kp A  &kp S  &kp D              &kp F  &kp G         &kp H            &kp J          &kp K      &kp L    &kp SEMI      &mt RIGHT_SHIFT SQT
&kp TAB  &kp Z  &kp X  &kp C              &kp V  &kp B         &kp N            &kp M          &kp COMMA  &kp DOT  &kp QUESTION  &kp RG(SPACE)
                       &mt (GLOBE) LG(Q)  &to 2  &kp ESCAPE    &mt ENTER SPACE  &kp BACKSPACE  &to 1
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp LA(UP_ARROW)  &kp LA(DOWN)   &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LA(LG(H))  &kp LA(J)          &kp N7         &kp N8          &kp N9          &kp N0           &kp RGUI            &kp BSPC
&kp N1            &kp N2         &kp N3              &kp N4               &kp N5         &kp N6             &mkp MCLK      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT     &msc MOVE_X(20)
&kp LG(LEFT)      &kp LG(RIGHT)  &kp LG(UP_ARROW)    &kp LG(DOWN)         &kp LA(LEFT)   &kp LA(RIGHT)      &kp RA(RG(B))  &kp RA(RG(I))   &kp RG(H)       &msc MOVE_Y(20)  &msc (MOVE_Y(-20))  &msc (MOVE_X(-20))
                                                     &new_macro2          &kp LC(LG(F))  &mt ENTER SPACE    &mkp LCLK      &mkp RCLK       &to 0
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB            &kp EXCL          &kp AT           &kp HASH        &kp DLLR            &kp PRCNT          &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp DOUBLE_QUOTES  &mmv MOVE_LEFT    &mmv MOVE_UP     &mmv MOVE_DOWN  &mmv MOVE_RIGHT     &kp COLON          &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&emojis            &kp LEFT_COMMAND  &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc (MOVE_Y(-20))  &msc MOVE_Y(20)    &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                                      &mkp RCLK       &mkp MCLK           &mkp LCLK          &kp RET    &kp SLASH  &to 0
            >;
        };

        layer_6 {
            bindings = <
&kp LG(A)          &kp LG(X)            &kp LG(C)         &kp LS(LG(Z))          &kp LG(Z)           &msc MOVE_Y(15)         &msc SCRL_LEFT    &kp PG_UP             &kp PG_DN        &msc SCRL_RIGHT  &kp RA(RG(T))  &mkp LCLK
&kp LA(LS(LG(S)))  &kp LG(RIGHT_BRACE)  &kp LA(LG(PIPE))  &kp LG(PIPE)           &kp LG(LEFT_BRACE)  &msc (MOVE_Y(-15))      &kp C_MUTE        &kp C_VOL_DN          &kp C_VOLUME_UP  &kp RA(RG(ESC))  &kp C_AL_LOCK  &kp RG(T)
&kp LC(LG(F))      &kp LA(LS(LG(V)))    &kp LG(V)         &kp LG(DOUBLE_QUOTES)  &kp LG(EQUAL)       &kp LG(SINGLE_QUOTE)    &kp C_PLAY_PAUSE  &kp C_BRIGHTNESS_DEC  &kp C_BRI_INC    &kp RG(R)        &kp RS(RG(L))  &kp RG(W)
                                                          &kp LA(LG(E))          &kp LA(LG(N))       &kp LG(N)               &kp RG(PLUS)      &kp RG(MINUS)         &to 0
            >;
        };

        layer_5 {
            bindings = <
&kp TAB        &kp P         &kp O    &kp I      &kp U     &kp Y              &kp T    &kp R                &kp E  &kp W  &kp Q  &mt DOUBLE_QUOTES SQT
&kp APOS       &kp SEMI      &kp L    &kp K      &kp J     &kp H              &kp G    &kp F                &kp D  &kp S  &kp A  &kp QUESTION
&kp LG(SPACE)  &kp QUESTION  &kp DOT  &kp COMMA  &kp M     &kp N              &kp B    &kp V                &kp C  &kp X  &kp Z  &kp COMMA
                                      &to 0      &kp BSPC  &mt ENTER SPACE    &kp ESC  &mt BACKSPACE SPACE  &to 0
            >;
        };
    };
};
