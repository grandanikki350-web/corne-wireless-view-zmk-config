#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        leftclick {
            bindings = <&mkp LCLK>;
            key-positions = <38 37>;
            layers = <0>;
            slow-release;
        };

        rightclick {
            bindings = <&mkp RCLK>;
            key-positions = <16 38>;
            layers = <0>;
            slow-release;
        };

        leftcontrol {
            bindings = <&kp RC(LEFT_ARROW)>;
            key-positions = <40 19>;
            layers = <0>;
            slow-release;
        };

        controlright {
            bindings = <&kp RC(RIGHT)>;
            key-positions = <20 40>;
        };

        MB4 {
            bindings = <&mkp MB4>;
            key-positions = <16 15>;
            layers = <2>;
            slow-release;
        };

        MB5 {
            bindings = <&mkp MB5>;
            key-positions = <16 3>;
            slow-release;
            layers = <2>;
        };

        MB4LW {
            bindings = <&mkp MB4>;
            key-positions = <19 20>;
            slow-release;
            layers = <1>;
        };

        MB5LW {
            bindings = <&mkp MB5>;
            key-positions = <19 8>;
            layers = <1>;
            slow-release;
        };
    };

    macros {
        new_macro2: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NEW_MACRO";
        };

        fullscreen: new_macro5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "NEW_MACRO5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&to 3  &kp Q  &kp W  &kp E  &kp R  &kp T             &kp Y            &kp U          &kp I      &kp O    &kp P         &sl 4
&to 5  &kp A  &kp S  &kp D  &kp F  &kp G             &kp H            &kp J          &kp K      &kp L    &to 4         &kp SQT
&to 4  &kp Z  &kp X  &kp C  &kp V  &kp B             &kp N            &kp M          &kp COMMA  &kp DOT  &mt CAPS TAB  &mt (QUESTION) RG(SPACE)
                     &sl 4  &to 2  &mt LGUI SPACE    &mt ENTER SPACE  &kp BACKSPACE  &to 1
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp LA(UP_ARROW)  &kp LA(DOWN)   &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LA(LG(H))  &kp LA(J)          &kp N7         &kp N8          &kp N9                 &kp N0           &mt (RGUI) RA(RG(L))  &kp BSPC
&kp N1            &kp N2         &kp N3              &kp N4               &kp N5         &kp N6             &mkp MCLK      &mmv MOVE_LEFT  &mmv MOVE_DOWN         &mmv MOVE_UP     &mmv MOVE_RIGHT       &msc MOVE_X(20)
&kp LG(LEFT)      &kp LG(RIGHT)  &kp LG(UP_ARROW)    &kp LG(DOWN)         &kp LA(LEFT)   &kp LA(RIGHT)      &kp RA(RG(B))  &kp RA(RG(I))   &mt RG(H) C_AL_LOGOFF  &msc MOVE_Y(20)  &msc (MOVE_Y(-20))    &msc (MOVE_X(-20))
                                                     &new_macro2          &fullscreen    &mt ENTER SPACE    &mkp LCLK      &mkp RCLK       &to 0
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&to 0        &kp EXCL        &kp AT           &kp HASH        &kp DLLR            &kp PRCNT              &kp CARET  &kp AMPS        &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&mkp MB4     &mmv MOVE_LEFT  &mmv MOVE_UP     &mmv MOVE_DOWN  &mmv MOVE_RIGHT     &mt COLON SEMICOLON    &kp MINUS  &kp EQUAL       &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&fullscreen  &mkp MB5        &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc (MOVE_Y(-20))  &msc MOVE_Y(20)        &kp UNDER  &kp PLUS        &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                              &mkp RCLK       &mkp MCLK           &mkp LCLK              &kp RET    &mt RGUI SLASH  &to 0
            >;
        };

        layer_6 {
            bindings = <
&kp LG(A)          &kp LG(X)            &kp LG(C)         &kp LS(LG(Z))          &kp LG(Z)           &msc MOVE_Y(15)         &msc SCRL_LEFT    &mkp MB4              &mkp MB5         &msc SCRL_RIGHT  &mt (RS(RG(T))) RA(RG(T))  &mkp LCLK
&kp LA(LS(LG(S)))  &kp LG(RIGHT_BRACE)  &kp LA(LG(PIPE))  &kp LG(PIPE)           &kp LG(LEFT_BRACE)  &msc (MOVE_Y(-15))      &kp C_MUTE        &kp C_VOL_DN          &kp C_VOLUME_UP  &kp RA(RG(ESC))  &kp C_AL_LOCK              &mt (RG(Q)) RG(T)
&fullscreen        &kp LA(LS(LG(V)))    &kp LG(V)         &kp LG(DOUBLE_QUOTES)  &kp LG(EQUAL)       &kp LG(SINGLE_QUOTE)    &kp C_PLAY_PAUSE  &kp C_BRIGHTNESS_DEC  &kp C_BRI_INC    &kp RG(R)        &kp RS(RG(L))              &kp RG(W)
                                                          &kp LA(LG(E))          &kp LA(LG(N))       &mt (LALT) LG(N)        &kp RG(PLUS)      &kp RG(MINUS)         &to 0
            >;
        };

        layer_5 {
            bindings = <
&kp TAB        &kp P         &kp O    &kp I      &kp U     &kp Y              &kp T    &kp R                &kp E  &kp W  &kp Q  &mt DOUBLE_QUOTES PERIOD
&kp APOS       &kp CLCK      &kp L    &kp K      &kp J     &kp H              &kp G    &kp F                &kp D  &kp S  &kp A  &kp EXCLAMATION
&kp LG(SPACE)  &kp QUESTION  &kp DOT  &kp COMMA  &kp M     &kp N              &kp B    &kp V                &kp C  &kp X  &kp Z  &to 4
                                      &to 0      &kp BSPC  &mt ENTER SPACE    &kp ESC  &mt BACKSPACE SPACE  &to 0
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans   &trans    &trans        &trans         &trans          &trans             &trans        &trans
&kp F8  &kp F7  &kp F6  &kp F5  &kp F4   &kp F9    &trans        &bt BT_NXT     &kp C_AC_REPLY  &kp RG(BACKSPACE)  &kp C_AC_INS  &trans
&trans  &trans  &trans  &trans  &kp F10  &trans    &trans        &trans         &trans          &sl 3              &trans        &trans
                        &kp F3  &kp F2   &kp F1    &kp K_CANCEL  &kp C_AC_SEND  &to 0
            >;
        };
    };
};
